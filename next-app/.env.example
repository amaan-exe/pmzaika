# ---------------------------------------------------------------------------
# PM Zaika backend – environment
# Copy to `.env.local` and fill in. Every value is optional: without Firebase
# credentials the backend runs against a local JSON store (see `persistenceMode`).
# ---------------------------------------------------------------------------

# --- Persistence ----------------------------------------------------------
# `firestore` or `local`. Auto-detected: firestore when the service account
# variables below are present, otherwise local.
# FIREBASE_MODE=firestore

# Firebase service account (Project settings -> Service accounts -> Generate key)
# FIREBASE_PROJECT_ID=pm-zaika-production
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pm-zaika-production.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_URL=https://pm-zaika-production-default-rtdb.firebaseio.com

# --- Firebase Web SDK (admin sign-in only, safe to expose) -----------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pm-zaika-production.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=pm-zaika-production
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pm-zaika-production.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Kitchen dashboard access --------------------------------------------
# Comma-separated list of e-mails allowed to open /admin.
# ADMIN_EMAILS=kitchen@pmzaika.com
# Password used ONLY in local persistence mode (no Firebase Auth).
# LOCAL_ADMIN_PASSWORD=change-me-before-deploying

# --- Restaurant details ---------------------------------------------------
# RESTAURANT_NAME=PM Zaika Restaurant
# RESTAURANT_WHATSAPP=917488260572
# NEXT_PUBLIC_SITE_URL=https://pmzaika.com

# --- UPI payments ---------------------------------------------------------
# UPI_VPA=pmzaika@ybl
# UPI_PAYEE_NAME=PM Zaika Restaurant
# Both are also editable at runtime via the admin settings desk, which wins.

# --- Pricing fallbacks (overridden by admin settings) ---------------------
# DELIVERY_FEE_PAISE=2900
# FREE_DELIVERY_ABOVE_PAISE=49900
# MIN_ORDER_PAISE=0
# MAX_QTY_PER_ITEM=20

# --- Notifications --------------------------------------------------------
# Telegram kitchen alerts (free – create a bot via @BotFather).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Web Push for kitchen devices (generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:kitchen@pmzaika.com

# Generic outbound webhook (Zapier/Make/SMS gateway). Receives JSON order events.
# ORDER_WEBHOOK_URL=

# --- Session --------------------------------------------------------------
# Secret used to sign local-mode admin cookies. Change in production.
# SESSION_SECRET=